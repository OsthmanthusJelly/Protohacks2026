{
    "tasks": [
        {
            "label": "Build game on open (Main/build.bat)",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\Main\\build.bat"],
            "runOptions": { "runOn": "folderOpen" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "Build raylib file (raylib installer, C:/raylib/w64devkit)",
            "command": "C:/raylib/w64devkit/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always", "-g", "-std=c++20",
                "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-IC:/raylib/raylib/src", "-LC:/raylib/raylib/src",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm", "-static"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "For PCs set up with the official raylib Windows installer"
        },
        {
            "type": "cppbuild",
            "label": "Build raylib file (WinLibs GCC 14, C:/mingw64 + C:/raylib)",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always", "-g", "-std=c++20",
                "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-IC:/raylib/include", "-LC:/raylib/lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm", "-static"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "For PCs with WinLibs in C:/mingw64 and the raylib mingw-w64 zip in C:/raylib"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/MinGW/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
